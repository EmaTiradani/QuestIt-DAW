{
  "name": "questit-daw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"prisma/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"prisma/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
