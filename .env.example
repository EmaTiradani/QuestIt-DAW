# PostgreSQL connection string used by Prisma.
# `sslmode=require` is mandatory: User.email is PII and the connection to the
# database must be encrypted in transit. Encryption at rest is the
# responsibility of the PostgreSQL hosting provider (see
# docs/daw/security/threat-FEAT-001.md).
DATABASE_URL="postgresql://user:password@localhost:5432/questit?sslmode=require"
